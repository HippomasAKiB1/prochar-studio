# ==============================================================================
# Prochar Studio — Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# API Configuration (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prochar-studio?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=
CLIENT_ORIGIN=http://localhost:3000

# Demo Credentials (used by seed script)
DEMO_PASSWORD=ProcharDemo2026!

# AI Provider ("gemini" | "mock")
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

# Storage Provider ("cloudinary" | "local")
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generation & Rate Limiting Controls
MAX_REGENERATIONS=3
GEN_RATE_PER_MIN=5
GEN_RATE_PER_DAY=30

# Puppeteer Rendering (set in Docker / leave blank for local auto-detection)
PUPPETEER_EXECUTABLE_PATH=

# ------------------------------------------------------------------------------
# Web Configuration (apps/web)
# ------------------------------------------------------------------------------
# Used by Next.js rewrites to proxy /api/* requests to the API server
API_URL=http://localhost:8080
