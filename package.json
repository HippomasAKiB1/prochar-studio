{
  "name": "prochar-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prochar Studio (প্রচার স্টুডিও) — AI-assisted Bangladeshi political poster generator",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@prochar/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "postinstall": "npm run build --workspace=@prochar/shared",
    "seed": "npm run build --workspace=@prochar/shared && npm run seed --workspace=@prochar/api",
    "seed:thumbnails": "npm run build --workspace=@prochar/shared && npm run seed:thumbnails --workspace=@prochar/api"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED"
}
